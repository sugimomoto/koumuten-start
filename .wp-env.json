{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.3",
  "port": 8890,
  "testsEnvironment": false,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp rewrite structure '/%postname%/' --hard"
  },
  "mappings": {
    "wp-content/themes/koumuten": "./wp-content/themes/koumuten",
    "wp-content/plugins/koumuten-core": "./wp-content/plugins/koumuten-core",
    "wp-content/mu-plugins": "./tests/mu-plugins"
  }
}
